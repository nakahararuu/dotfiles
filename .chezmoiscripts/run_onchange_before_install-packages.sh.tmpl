#!/bin/bash
set -euo pipefail

{{ $machineType := .machineType | default "biz" }}

{{ $brewfile := "bizBrewfile" }}
{{ if eq $machineType "private" -}}
{{   $brewfile = "privateBrewfile" }}
{{ end -}}

# Brewfile hash: {{ include $brewfile | sha256sum }}
# ↑ このハッシュ値をコメントに埋め込むことで、Brewfile の内容が変わる
#   （手動編集、または GitHub Actions によるタイムスタンプの週次更新）
#   たびに run_onchange_ スクリプトが再実行され、brew bundle install/cleanup が走る。

BREWFILE_PATH="{{ .chezmoi.sourceDir }}/{{ $brewfile }}"

echo "Using Brewfile: $BREWFILE_PATH"
sudo -v
brew bundle --file="$BREWFILE_PATH"
brew bundle cleanup --file="$BREWFILE_PATH" --force

exit 0
