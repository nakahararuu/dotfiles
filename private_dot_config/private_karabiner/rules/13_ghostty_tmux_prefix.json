{
    "description": "Ghostty: Use super_key+a as tmux prefix (sent as F13)",
    "manipulators": [
        {
            "type": "basic",
            "from": {
                "key_code": "a",
                "modifiers": {
                    "mandatory": [
                        "left_command",
                        "left_control",
                        "left_option",
                        "left_shift"
                    ]
                }
            },
            "to": [
                {
                    "key_code": "f13"
                }
            ],
            "conditions": [
                {
                    "type": "frontmost_application_if",
                    "bundle_identifiers": [
                        "^com\\.mitchellh\\.ghostty$"
                    ]
                }
            ]
        }
    ]
}
